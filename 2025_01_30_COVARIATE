        "## ISHIKAWA et al. (2023) — virtual covariates (n = 1,000)\n",
        "## Source: Ishikawa E, et al. Invest New Drugs 2023;41:122-133, Table 1 (n = 53)\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "SEED = 20241004                     # 고정 시드 (Methods/README에 기재)\n",
        "rng = np.random.default_rng(SEED)\n",
        "N = 1000\n",
        "\n",
        "# Brown et al. (2017) observed ranges — Methods: generated values constrained to these ranges\n",
        "RANGE = {'AGE': (21, 89), 'WT': (33, 122), 'ALB': (2.8, 53.3),\n",
        "         'AST': (6, 258), 'ALT': (4, 277), 'SCR': (22.4, 192.4)}\n",
        "\n",
        "def from_median_iqr(median, q1, q3, lo, hi, size):\n",
        "    \"\"\"Normal(mean = median, SD = IQR/1.35); values outside [lo, hi] are redrawn.\"\"\"\n",
        "    sd = (q3 - q1) / 1.35\n",
        "    x = rng.normal(median, sd, size)\n",
        "    out = (x < lo) | (x > hi)\n",
        "    while out.any():\n",
        "        x[out] = rng.normal(median, sd, out.sum())\n",
        "        out = (x < lo) | (x > hi)\n",
        "    return x\n",
        "\n",
        "# Sex: male 21 / 53 (39.6%) -> exact count, random order (Male = 1, Female = 0)\n",
        "n_male = round(21 / 53 * N)                                        # 396\n",
        "sex = rng.permutation(np.r_[np.ones(n_male, int), np.zeros(N - n_male, int)])\n",
        "\n",
        "# Unit conversions to match the analysis dataset\n",
        "ALB_GL = 10        # g/dL  -> g/L      (4.0 [3.8-4.3] g/dL)\n",
        "SCR_UMOL = 88.42   # mg/dL -> umol/L   (0.83 [0.70-1.06] mg/dL)\n",
        "\n",
        "df = pd.DataFrame({\n",
        "    'ID':  np.arange(1, N + 1),\n",
        "    'SEX': sex,\n",
        "    'AGE': from_median_iqr(69,   60,   74,   *RANGE['AGE'], N),\n",
        "    'WT':  from_median_iqr(55,   49,   64,   *RANGE['WT'],  N),\n",
        "    'ALB': from_median_iqr(4.0*ALB_GL, 3.8*ALB_GL, 4.3*ALB_GL, *RANGE['ALB'], N),\n",
        "    'AST': from_median_iqr(23,   19,   28,   *RANGE['AST'], N),\n",
        "    'ALT': from_median_iqr(17,   12,   23,   *RANGE['ALT'], N),\n",
        "    'SCR': from_median_iqr(0.83*SCR_UMOL, 0.70*SCR_UMOL, 1.06*SCR_UMOL, *RANGE['SCR'], N),\n",
        "    'MN':  4,                                                       # source study: Ishikawa\n",
        "})\n",
        "df.to_csv('ISHI_COV.csv', index=False)\n",
        "\n",
        "# Check against Table 1 of the source publication\n",
        "summ = df[['AGE', 'WT', 'ALB', 'AST', 'ALT', 'SCR']].quantile([.25, .5, .75]).T.round(1)\n",
        "summ.columns = ['Q1', 'Median', 'Q3']\n",
        "print(summ)\n",
        "print('Male: %d (%.1f%%)' % (df.SEX.sum(), df.SEX.mean() * 100))"
      ],
