        "## BROWN et al. (2017) — virtual covariates (n = 1,000)\n",
        "## Source: Brown K, et al. Br J Clin Pharmacol 2017;83:1216-1226, Table 1 (n = 778)\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "SEED = 20241001                     # 고정 시드 (Methods/README에 기재)\n",
        "rng = np.random.default_rng(SEED)\n",
        "N = 1000\n",
        "\n",
        "def from_mean_sd(mean, sd, lo, hi, size):\n",
        "    \"\"\"Normal(mean, SD); values outside the reported range [lo, hi] are redrawn.\"\"\"\n",
        "    x = rng.normal(mean, sd, size)\n",
        "    out = (x < lo) | (x > hi)\n",
        "    while out.any():\n",
        "        x[out] = rng.normal(mean, sd, out.sum())\n",
        "        out = (x < lo) | (x > hi)\n",
        "    return x\n",
        "\n",
        "# Sex: male 491 / 778 (63.1%) -> exact count, random order (Male = 1, Female = 0)\n",
        "n_male = round(491 / 778 * N)                                      # 631\n",
        "sex = rng.permutation(np.r_[np.ones(n_male, int), np.zeros(N - n_male, int)])\n",
        "\n",
        "df = pd.DataFrame({\n",
        "    'ID':   np.arange(1, N + 1),\n",
        "    'SEX':  sex,\n",
        "    'AGE':  from_mean_sd(60.2, 11.9, 21,   89,    N),\n",
        "    'WT':   from_mean_sd(63.3, 14.3, 33,   122,   N),               # body weight reported directly\n",
        "    'ALB':  from_mean_sd(38.4, 5.3,  2.8,  53.3,  N),               # g/L\n",
        "    'AST':  from_mean_sd(26.7, 16.7, 6,    258,   N),\n",
        "    'ALT':  from_mean_sd(21.8, 18.5, 4,    277,   N),\n",
        "    'CRCL': from_mean_sd(85,   28.2, 22.4, 192.4, N),               # estimated CrCl (mL/min)\n",
        "    'SCR':  np.nan,                                                 # serum creatinine not reported\n",
        "    'MN':   1,                                                      # source study: Brown\n",
        "})\n",
        "df.to_csv('Brown_COV.csv', index=False)\n",
        "\n",
        "# Check against Table 1 of the source publication\n",
        "summ = df[['AGE', 'WT', 'ALB', 'AST', 'ALT', 'CRCL']].agg(['mean', 'std', 'median', 'min', 'max']).T.round(1)\n",
        "print(summ)\n",
        "print('Male: %d (%.1f%%)' % (df.SEX.sum(), df.SEX.mean() * 100))"
      ]
