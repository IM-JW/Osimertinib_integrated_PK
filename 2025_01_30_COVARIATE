      "cell_type": "code",
      "source": [
        "## RODIER et al. (2022) — virtual covariates (n = 1,000)\n",
        "## Source: Rodier T, et al. Pharmaceutics 2022;14:1844, Table 1 (osimertinib cohort, n = 87)\n",
        "## Characteristics are reported by treatment line only -> generated within each line, then combined\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "SEED = 20241002                     # 고정 시드 (Methods/README에 기재)\n",
        "rng = np.random.default_rng(SEED)\n",
        "N = 1000\n",
        "\n",
        "# Brown et al. (2017) observed ranges — Methods: generated values constrained to these ranges\n",
        "RANGE = {'AGE': (21, 89), 'BMI': (14.9, 42.6), 'WT': (33, 122), 'ALB': (2.8, 53.3),\n",
        "         'AST': (6, 258), 'ALT': (4, 277), 'SCR': (22.4, 192.4)}\n",
        "\n",
        "def from_median_iqr(median, q1, q3, lo, hi, size):\n",
        "    \"\"\"Normal(mean = median, SD = IQR/1.35); values outside [lo, hi] are redrawn.\"\"\"\n",
        "    sd = (q3 - q1) / 1.35\n",
        "    x = rng.normal(median, sd, size)\n",
        "    out = (x < lo) | (x > hi)\n",
        "    while out.any():\n",
        "        x[out] = rng.normal(median, sd, out.sum())\n",
        "        out = (x < lo) | (x > hi)\n",
        "    return x\n",
        "\n",
        "# Table 1 by treatment line: n, female n, then median [Q1, Q3]\n",
        "LINES = {\n",
        "    '1st': dict(n=28, female=16, AGE=(63.0, 55.8, 72.2), BMI=(22.0, 19.6, 24.4), ALB=(40.0, 35.5, 42.8),\n",
        "                AST=(22.0, 18.0, 30.5), ALT=(24.0, 14.5, 43.0), SCR=(64.5, 58.0, 75.5)),\n",
        "    '2nd': dict(n=47, female=34, AGE=(68.0, 56.5, 78.5), BMI=(23.2, 21.0, 26.0), ALB=(38.0, 36.0, 40.0),\n",
        "                AST=(26.0, 22.0, 31.5), ALT=(26.0, 17.5, 33.0), SCR=(82.0, 70.0, 94.0)),\n",
        "    '3rd+': dict(n=12, female=10, AGE=(69.5, 59.2, 73.0), BMI=(21.1, 17.9, 23.9), ALB=(41.0, 39.5, 42.5),\n",
        "                AST=(21.0, 18.0, 27.5), ALT=(18.0, 17.5, 33.5), SCR=(74.5, 61.0, 82.5)),\n",
        "}\n",
        "N_TOTAL = sum(v['n'] for v in LINES.values())                      # 87\n",
        "\n",
        "# Mean height (m) by sex and age group — NHANES 2015-2018 (ref. 19)\n",
        "def height(age, sex):                                              # sex: Male = 1, Female = 0\n",
        "    table = [(30, 1.758, 1.626), (40, 1.763, 1.627), (50, 1.763, 1.623), (60, 1.754, 1.613),\n",
        "             (70, 1.744, 1.607), (80, 1.730, 1.582), (90, 1.704, 1.556)]\n",
        "    for upper, m, f in table:\n",
        "        if age < upper:\n",
        "            return m if sex == 1 else f\n",
        "    return 1.704 if sex == 1 else 1.556\n",
        "\n",
        "parts = []\n",
        "for line, p in LINES.items():\n",
        "    n = round(p['n'] / N_TOTAL * N)                                # 322 / 540 / 138\n",
        "    n_male = round((p['n'] - p['female']) / p['n'] * n)\n",
        "    sex = rng.permutation(np.r_[np.ones(n_male, int), np.zeros(n - n_male, int)])\n",
        "    age = from_median_iqr(*p['AGE'], *RANGE['AGE'], n)\n",
        "    ht = np.array([height(a, s) for a, s in zip(age, sex)])\n",
        "    # BMI -> body weight; BMI redrawn if BMI or resulting weight is outside the Brown range\n",
        "    bmi = from_median_iqr(*p['BMI'], *RANGE['BMI'], n)\n",
        "    wt = bmi * ht ** 2\n",
        "    out = (wt < RANGE['WT'][0]) | (wt > RANGE['WT'][1])\n",
        "    while out.any():\n",
        "        bmi[out] = from_median_iqr(*p['BMI'], *RANGE['BMI'], out.sum())\n",
        "        wt = bmi * ht ** 2\n",
        "        out = (wt < RANGE['WT'][0]) | (wt > RANGE['WT'][1])\n",
        "    parts.append(pd.DataFrame({\n",
        "        'LINE': line, 'SEX': sex, 'AGE': age, 'HT': ht, 'BMI': bmi, 'WT': wt,\n",
        "        'ALB': from_median_iqr(*p['ALB'], *RANGE['ALB'], n),       # g/L\n",
        "        'AST': from_median_iqr(*p['AST'], *RANGE['AST'], n),\n",
        "        'ALT': from_median_iqr(*p['ALT'], *RANGE['ALT'], n),\n",
        "        'SCR': from_median_iqr(*p['SCR'], *RANGE['SCR'], n),       # umol/L\n",
        "    }))\n",
        "\n",
        "df = pd.concat(parts, ignore_index=True)\n",
        "df.insert(0, 'ID', np.arange(1, len(df) + 1))\n",
        "df['MN'] = 2                                                        # source study: Rodier\n",
        "df.to_csv('Rodier_COV.csv', index=False)\n",
        "\n",
        "# Check against Table 1 of the source publication (by line)\n",
        "for line, g in df.groupby('LINE', sort=False):\n",
        "    s = g[['AGE', 'BMI', 'ALB', 'AST', 'ALT', 'SCR']].quantile([.25, .5, .75]).T.round(1)\n",
        "    print(f'--- {line} line: n = {len(g)}, female = {(g.SEX == 0).sum()} ({(g.SEX == 0).mean()*100:.1f}%)')\n",
        "    print(s.rename(columns={.25: 'Q1', .5: 'Median', .75: 'Q3'}))\n",
        "print('Total: n = %d, male = %d (%.1f%%), WT %.1f [%.1f-%.1f]' % (\n",
        "    len(df), df.SEX.sum(), df.SEX.mean() * 100, df.WT.median(), df.WT.quantile(.25), df.WT.quantile(.75)))"
      ],
